#!/usr/bin/env bash
set -u

usage() {
  echo "usage: proofcast [--out recording.mp4] -- command [args...]" >&2
  exit 2
}

output=
while [ "$#" -gt 0 ]; do
  case "$1" in
    --out)
      [ "$#" -ge 2 ] || usage
      output=$2
      shift 2
      ;;
    --)
      shift
      break
      ;;
    -h|--help)
      usage
      ;;
    *)
      usage
      ;;
  esac
done

[ "$#" -gt 0 ] || usage

for tool in asciinema agg ffmpeg; do
  command -v "$tool" >/dev/null 2>&1 || {
    echo "proofcast: missing dependency: $tool" >&2
    exit 1
  }
done

if [ -z "$output" ]; then
  output="$PWD/proofcast-$(date +%Y%m%d-%H%M%S).mp4"
elif [ "${output#/}" = "$output" ]; then
  output="$PWD/$output"
fi

output_dir=$(dirname -- "$output")
[ -d "$output_dir" ] || {
  echo "proofcast: output directory does not exist: $output_dir" >&2
  exit 1
}
output_dir=$(cd -- "$output_dir" && pwd -L)
output="$output_dir/$(basename -- "$output")"

[ ! -e "$output" ] || {
  echo "proofcast: output already exists: $output" >&2
  exit 1
}

work=$(mktemp -d /tmp/proofcast.XXXXXX) || exit 1
runner="$work/run.sh"
cast="$work/recording.cast"
gif="$work/recording.gif"
video="$work/recording.mp4"
complete=0

cleanup() {
  if [ "$complete" -eq 1 ]; then
    rm -rf -- "$work"
  else
    echo "proofcast: recording evidence kept at $work" >&2
  fi
}
trap cleanup EXIT

{
  printf '#!/usr/bin/env bash\n'
  printf 'cmd=('
  for arg in "$@"; do
    printf ' %q' "$arg"
  done
  printf ' )\n'
  printf 'printf "\\$ "\n'
  printf 'printf "%%q " "${cmd[@]}"\n'
  printf 'printf "\\n"\n'
  printf 'exec "${cmd[@]}"\n'
} >"$runner"
chmod 700 "$runner"

# Fixed geometry: headless recording otherwise falls back to 80x24 and long
# lines wrap out of view in the rendered video.
asciinema record --headless --window-size 160x42 --return --overwrite --command "$runner" "$cast"
command_status=$?

# asciinema >= 3.2 requires --overwrite even when converting to stdout
asciinema convert --overwrite -f txt "$cast" - || exit 1
# A proof recording spans the whole run, start to finish — idle is kept, not
# collapsed (agg's default caps idle gaps at 5s and the video lies about time).
agg --font-size 16 --idle-time-limit 3600 "$cast" "$gif" || exit 1
# fps=24 resamples the GIF's variable frame delays to constant framerate —
# without it the mp4 carries a handful of long-held frames and players stutter
# and scrub-jump.
ffmpeg -hide_banner -loglevel error -y -i "$gif" \
  -c:v libx264 -pix_fmt yuv420p \
  -vf 'fps=24,pad=ceil(iw/2)*2:ceil(ih/2)*2' \
  -movflags +faststart "$video" || exit 1

chmod 600 "$video"
mv -- "$video" "$output" || exit 1
complete=1
printf '\n%s\n' "$output"
exit "$command_status"
